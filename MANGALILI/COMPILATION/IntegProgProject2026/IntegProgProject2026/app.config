<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <startup>
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.0" />
    </startup>
    <connectionStrings>
        <add name="ProjectDB"
             connectionString="Provider=Microsoft.SQLSERVER.CE.OLEDB.3.5;Data Source=projectDB.sdf;Persist Security Info=False;"
             providerName="System.Data.OleDb" />
    </connectionStrings>
    <appSettings>
        <add key="DatabaseFile" value="projectDB.sdf" />
        <add key="XmlStoreFile" value="projectDB_Schedules.xml; projectDB_Quotes.xml; projectDB_BibleVerses.xml" />
        <add key="LogFile" value="forms_log.txt" />
        <add key="UserInfo" value="Mangalili, Fhetz  |  BSIT 3B" />
        <add key="ApplicationName" value="IntegProgProject2026" />
    </appSettings>
</configuration>
